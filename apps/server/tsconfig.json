{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": false,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"]
        },
        "types": ["node"],
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": ["**/*.ts", "**/*.vue", ".nuxt/**/*.ts"],
    "exclude": ["node_modules"]
}
